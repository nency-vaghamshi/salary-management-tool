<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <%= render "shared/head" %>
  </head>

  <body class="h-full">
    <%= render "shared/flash" %>

    <% if current_user %>
      <div data-controller="sidebar" data-action="keydown@window->sidebar#closeOnEscape">
        <%= render "shared/sidebar" %>

        <div class="lg:pl-64">
          <header class="sticky top-0 z-30 flex h-16 items-center gap-3 border-b border-gray-200 bg-white/95 px-4 backdrop-blur sm:px-6 lg:px-8">
            <button type="button" data-sidebar-target="toggle" data-action="sidebar#open"
                    aria-controls="app-sidebar" aria-expanded="false"
                    class="-ml-1.5 rounded-md p-1.5 text-gray-600 hover:bg-gray-100 lg:hidden">
              <%= icon(:menu, label: "Open navigation") %>
            </button>
            <span class="text-sm font-semibold tracking-tight text-gray-900 lg:hidden">ACME Salary</span>

            <div class="ml-auto flex items-center gap-3">
              <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-indigo-50 text-xs font-semibold text-indigo-700" aria-hidden="true">
                <%= initials_for(current_user.name) %>
              </span>
              <div class="hidden min-w-0 sm:block">
                <p class="truncate text-sm font-medium text-gray-900"><%= current_user.name %></p>
                <p class="truncate text-xs text-gray-500"><%= role_label(current_user.role) %></p>
              </div>
              <span class="mx-1 hidden h-6 w-px bg-gray-200 sm:block" aria-hidden="true"></span>
              <button type="button" data-controller="logout" data-action="click->logout#perform"
                      class="rounded-md p-1.5 text-gray-400 hover:bg-gray-100 hover:text-gray-700" title="Sign out">
                <%= icon(:logout, label: "Sign out") %>
              </button>
            </div>
          </header>

          <main class="px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
            <div class="mx-auto max-w-7xl">
              <%= yield %>
            </div>
          </main>
        </div>
      </div>
    <% else %>
      <main class="px-4 py-8"><%= yield %></main>
    <% end %>
  </body>
</html>
