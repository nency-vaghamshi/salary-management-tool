<%# Toast stack, top-right. role=status/alert so screen readers announce it. %>
<% messages = [ [ :notice, notice ], [ :alert, alert ] ].select { |_, message| message.present? } %>
<% if messages.any? %>
  <div class="pointer-events-none fixed inset-x-4 top-20 z-[60] flex flex-col items-end gap-2 sm:left-auto sm:right-6 sm:w-96">
    <% messages.each do |kind, message| %>
      <% success = kind == :notice %>
      <div data-controller="toast" data-toast-autohide-value="<%= success %>" role="<%= success ? 'status' : 'alert' %>"
           class="pointer-events-auto flex w-full items-start gap-3 rounded-lg bg-white p-4 shadow-lg ring-1 ring-gray-900/10 transition-opacity duration-200">
        <%= icon(success ? :check_circle : :alert_circle, css: "size-5 shrink-0 #{success ? 'text-green-600' : 'text-red-600'}") %>
        <p class="flex-1 text-sm text-gray-900"><%= message %></p>
        <button type="button" data-action="toast#dismiss" class="-m-1 rounded-md p-1 text-gray-400 hover:text-gray-600">
          <%= icon(:close, css: "size-4", label: "Dismiss") %>
        </button>
      </div>
    <% end %>
  </div>
<% end %>
