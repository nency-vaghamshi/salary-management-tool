<% if notice %>
  <div class="rounded-lg bg-indigo-50 text-indigo-800 text-sm px-4 py-3 ring-1 ring-indigo-100 mb-5">
    <%= notice %>
  </div>
<% end %>

<% if alert %>
  <div class="rounded-lg bg-red-50 text-red-700 text-sm px-4 py-3 ring-1 ring-red-100 mb-5">
    <%= alert %>
  </div>
<% end %>
