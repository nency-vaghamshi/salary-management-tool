<% if pagy.pages > 1 %>
  <nav class="flex items-center gap-1" aria-label="Pagination">
    <% if pagy.prev %>
      <%= link_to pagy_url_for(pagy, pagy.prev), class: "w-8 h-8 flex items-center justify-center rounded-md text-gray-500 hover:bg-gray-100 hover:text-gray-900", "aria-label": "Previous page" do %>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
      <% end %>
    <% else %>
      <span class="w-8 h-8 flex items-center justify-center rounded-md text-gray-300" aria-disabled="true">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
      </span>
    <% end %>

    <% pagy.series.each do |item| %>
      <% if item.is_a?(Integer) %>
        <%= link_to item, pagy_url_for(pagy, item), class: "min-w-8 h-8 px-2 flex items-center justify-center rounded-md text-sm text-gray-600 hover:bg-gray-100 hover:text-gray-900" %>
      <% elsif item == :gap %>
        <span class="min-w-8 h-8 px-1 flex items-center justify-center text-sm text-gray-400">&hellip;</span>
      <% else %>
        <span class="min-w-8 h-8 px-2 flex items-center justify-center rounded-md text-sm font-medium bg-indigo-600 text-white" aria-current="page"><%= item %></span>
      <% end %>
    <% end %>

    <% if pagy.next %>
      <%= link_to pagy_url_for(pagy, pagy.next), class: "w-8 h-8 flex items-center justify-center rounded-md text-gray-500 hover:bg-gray-100 hover:text-gray-900", "aria-label": "Next page" do %>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
      <% end %>
    <% else %>
      <span class="w-8 h-8 flex items-center justify-center rounded-md text-gray-300" aria-disabled="true">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
      </span>
    <% end %>
  </nav>
<% end %>
