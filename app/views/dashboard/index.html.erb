<% content_for :title, "Dashboard" %>

<div class="w-full space-y-6">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-xl font-semibold text-gray-900">Dashboard</h1>
      <p class="text-sm text-gray-500">
        <% if @currency %>
          Headcount and compensation for employees paid in <span class="font-medium text-gray-700"><%= @currency.label %></span>.
        <% else %>
          Organization-wide snapshot of headcount and compensation.
        <% end %>
      </p>
    </div>

    <% if @currency_options.any? %>
      <%= form_with url: dashboard_path, method: :get, data: { controller: "roster-filters" } do %>
        <label class="block text-xs font-medium text-gray-500 mb-1" for="currency_id">Salary currency</label>
        <%= select_tag :currency_id,
              options_for_select(@currency_options.map { |option| [ "#{option.label} (#{number_with_delimiter(option.employee_count)})", option.id ] }, @currency.id),
              data: { action: "change->roster-filters#submit" },
              class: "rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        <noscript><button type="submit" class="ml-2 text-sm text-indigo-600">Apply</button></noscript>
      <% end %>
    <% end %>
  </div>

  <% if @currency.nil? %>
    <div class="bg-white rounded-lg ring-1 ring-gray-200 p-8 text-center text-sm text-gray-500">
      No active salary records yet. Add salaries to employees to see compensation metrics here.
    </div>
  <% else %>
    <% money = ->(amount) { number_to_currency(amount, unit: @currency.symbol, precision: 0) } %>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="bg-white rounded-lg ring-1 ring-gray-200 p-4">
        <div class="w-9 h-9 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center mb-3">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="<%= dashboard_stat_icon_path(:users) %>" />
          </svg>
        </div>
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Employees</p>
        <p class="mt-1 text-2xl font-semibold text-gray-900"><%= number_with_delimiter(@total_employees) %></p>
        <p class="mt-0.5 text-xs text-gray-400">Paid in <%= @currency.code %></p>
      </div>

      <div class="bg-white rounded-lg ring-1 ring-gray-200 p-4">
        <div class="w-9 h-9 rounded-lg bg-teal-50 text-teal-600 flex items-center justify-center mb-3">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="<%= dashboard_stat_icon_path(:currency) %>" />
          </svg>
        </div>
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Total annual compensation</p>
        <p class="mt-1 text-2xl font-semibold text-gray-900"><%= money.(@total_annual_compensation) %></p>
        <p class="mt-0.5 text-xs text-gray-400"><%= @currency.code %></p>
      </div>

      <div class="bg-white rounded-lg ring-1 ring-gray-200 p-4">
        <div class="w-9 h-9 rounded-lg bg-teal-50 text-teal-600 flex items-center justify-center mb-3">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="<%= dashboard_stat_icon_path(:currency) %>" />
          </svg>
        </div>
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Average salary</p>
        <p class="mt-1 text-2xl font-semibold text-gray-900"><%= money.(@average_salary) %></p>
        <p class="mt-0.5 text-xs text-gray-400"><%= @currency.code %></p>
      </div>
    </div>

    <%= render "payroll_cost_chart", chart: @payroll_chart, currency: @currency, money: money %>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="bg-white rounded-lg ring-1 ring-gray-200 p-5">
        <div class="flex items-center gap-2 mb-0.5">
          <span class="w-2 h-2 rounded-full bg-teal-500"></span>
          <h2 class="text-sm font-semibold text-gray-900">Average salary by department</h2>
        </div>
        <p class="text-xs text-gray-400 mb-4 pl-4">In <%= @currency.code %></p>
        <% max_average = @department_stats.map(&:average_compensation).max.to_f %>
        <div>
          <% @department_stats.each.with_index(1) do |stat, rank| %>
            <%= render "bar_row",
                  rank: rank,
                  name: stat.name,
                  share: max_average.zero? ? 0 : (stat.average_compensation.to_f / max_average * 100).round(1),
                  value_label: money.(stat.average_compensation),
                  color: "bg-teal-500" %>
          <% end %>
        </div>
      </div>

      <div class="bg-white rounded-lg ring-1 ring-gray-200 p-5">
        <div class="flex items-center justify-between gap-2 mb-0.5">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
            <h2 class="text-sm font-semibold text-gray-900">Month-wise payroll</h2>
          </div>
          <%= link_to "All runs", payroll_runs_path, class: "text-xs text-indigo-600 hover:text-indigo-800" %>
        </div>
        <p class="text-xs text-gray-400 mb-4 pl-4">Actually paid in completed runs, in <%= @currency.code %> &middot; last <%= DashboardController::PAYROLL_MONTHS_SHOWN %> months</p>

        <% if @monthly_payrolls.any? %>
          <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
              <thead class="text-left text-xs font-medium text-gray-500 uppercase tracking-wide">
                <tr>
                  <th class="pb-2 pr-3">Month</th>
                  <th class="pb-2 px-3 text-right">Paid</th>
                  <th class="pb-2 px-3 text-right">Gross</th>
                  <th class="pb-2 px-3 text-right">Tax</th>
                  <th class="pb-2 pl-3 text-right">Net</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100 tabular-nums">
                <% @monthly_payrolls.each do |row| %>
                  <tr>
                    <td class="py-2 pr-3 text-gray-900 whitespace-nowrap"><%= row.month.strftime("%b %Y") %></td>
                    <td class="py-2 px-3 text-right text-gray-500"><%= number_with_delimiter(row.employee_count) %></td>
                    <td class="py-2 px-3 text-right text-gray-500 whitespace-nowrap"><%= money.(row.gross_total) %></td>
                    <td class="py-2 px-3 text-right text-gray-500 whitespace-nowrap"><%= money.(row.tax_total) %></td>
                    <td class="py-2 pl-3 text-right text-gray-900 font-medium whitespace-nowrap"><%= money.(row.net_total) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-sm text-gray-500 py-6 text-center">
            No completed payroll runs in <%= @currency.code %> yet.
            <%= link_to "Run payroll", new_payroll_run_path, class: "text-indigo-600 hover:text-indigo-800" %>
          </p>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
