<div class="group flex items-center gap-3 -mx-2 px-2 py-1 rounded-md hover:bg-gray-50" title="<%= name %>: <%= value_label %>">
  <span class="w-4 shrink-0 text-right text-[11px] font-medium text-gray-300 group-hover:text-gray-400 tabular-nums"><%= rank %></span>
  <div class="w-28 shrink-0 truncate text-sm text-gray-700"><%= name %></div>
  <div class="flex-1 bg-gray-100 h-2">
    <div class="h-2 <%= color %> rounded-r-[4px]" style="width: <%= share %>%"></div>
  </div>
  <div class="min-w-28 shrink-0 whitespace-nowrap text-right text-xs text-gray-500 tabular-nums"><%= value_label %></div>
</div>
