<% page_title = @employee.current_salary_record ? "Revise Salary" : "Add Salary" %>
<% content_for :title, page_title %>

<div class="w-full max-w-lg">
  <h1 class="text-xl font-semibold text-gray-900 mb-1"><%= page_title %></h1>
  <p class="text-sm text-gray-500 mb-6"><%= @employee.full_name %> &middot; <%= @employee.employee_number %></p>

  <% if @errors.present? %>
    <div class="rounded-lg bg-red-50 text-red-700 text-sm px-3.5 py-2.5 ring-1 ring-red-100 mb-5">
      <p class="font-medium mb-1"><%= pluralize(@errors.count, "error") %> prevented this salary from being saved:</p>
      <ul class="list-disc list-inside">
        <% @errors.each { |message| %><li><%= message %></li><% } %>
      </ul>
    </div>
  <% end %>

  <%= form_with url: salary_records_path, method: :post, class: "space-y-5" do %>
    <%= hidden_field_tag :employee_id, @employee.id %>

    <% unless @employment %>
      <div class="rounded-lg bg-gray-50 ring-1 ring-gray-200 p-4 space-y-4">
        <div>
          <p class="text-sm font-medium text-gray-900">Employment</p>
          <p class="text-xs text-gray-500">This is their first salary, so an employment record is created with it. Tax is calculated from the payroll country.</p>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5" for="payroll_country_id">Payroll country</label>
            <%= select_tag :payroll_country_id, options_from_collection_for_select(@countries, :id, :name, params[:payroll_country_id]),
                  include_blank: "Select a country",
                  class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5" for="start_date">Start date</label>
            <input type="date" id="start_date" name="start_date" value="<%= params[:start_date] || Date.current %>"
                   class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
          </div>
        </div>
      </div>
    <% end %>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5" for="currency_id">Currency</label>
        <%= select_tag :currency_id, options_from_collection_for_select(@currencies, :id, :code, params[:currency_id] || @employment&.payroll_country&.currency_id),
              include_blank: @employment ? false : "Select a currency",
              class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5" for="effective_from">Effective from</label>
        <input type="date" id="effective_from" name="effective_from" value="<%= params[:effective_from] || Date.current %>"
               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-2">Salary components</label>
      <div class="space-y-2">
        <% @components.each do |component| %>
          <div class="flex items-center justify-between gap-3 bg-white rounded-lg ring-1 ring-gray-200 px-3.5 py-2.5">
            <span class="text-sm text-gray-700">
              <%= component.name %>
              <% unless component.is_taxable %><span class="text-xs text-gray-400">(non-taxable)</span><% end %>
            </span>
            <input type="number" step="0.01" min="0" name="components[<%= component.id %>]" placeholder="0.00"
                   value="<%= params.dig(:components, component.id.to_s) %>"
                   class="w-32 rounded-lg border border-gray-300 px-3 py-1.5 text-sm text-right focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
          </div>
        <% end %>
      </div>
    </div>

    <div class="flex items-center gap-3 pt-2">
      <%= submit_tag "Save Salary", class: "inline-flex items-center justify-center bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium rounded-lg px-4 py-2.5 transition-colors cursor-pointer" %>
      <%= link_to "Cancel", employee_path(@employee), class: "text-sm text-gray-500 hover:text-gray-900" %>
    </div>
  <% end %>
</div>
