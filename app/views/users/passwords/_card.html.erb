<%# Shared frame for the password pages. locals: title, subtitle; yields the form. %>
<div class="flex min-h-screen items-center justify-center px-4 py-12">
  <div class="w-full max-w-sm">
    <div class="mb-8 flex items-center gap-2.5">
      <span class="flex size-9 items-center justify-center rounded-lg bg-indigo-600 text-white">
        <%= icon(:brand, css: "size-5") %>
      </span>
      <span class="font-semibold tracking-tight text-gray-900">ACME Salary</span>
    </div>

    <h1 class="text-2xl font-semibold text-gray-900"><%= title %></h1>
    <p class="mt-1 mb-8 text-sm text-gray-500"><%= subtitle %></p>

    <% if resource.errors.any? %>
      <div class="mb-5 rounded-lg bg-red-50 px-3.5 py-2.5 text-sm text-red-700 ring-1 ring-red-100" role="alert">
        <ul class="list-inside list-disc space-y-0.5">
          <% resource.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
        </ul>
      </div>
    <% end %>

    <%= yield %>

    <p class="mt-6 text-center text-sm text-gray-500">
      Remembered it? <%= link_to "Back to sign in", login_path, class: "font-medium text-indigo-600 hover:text-indigo-700" %>
    </p>
  </div>
</div>
