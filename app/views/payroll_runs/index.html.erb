<% content_for :title, "Payroll Runs" %>

<div class="w-full">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-semibold text-gray-900">Payroll Runs</h1>
    <%= link_to "New Payroll Run", new_payroll_run_path, class: "inline-flex items-center justify-center bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium rounded-lg px-4 py-2.5 transition-colors" %>
  </div>

  <div class="bg-white rounded-lg ring-1 ring-gray-200 overflow-x-auto">
    <table class="min-w-full text-sm">
      <thead class="bg-gray-50 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">
        <tr>
          <th class="px-4 py-3">Period</th>
          <th class="px-4 py-3">Status</th>
          <th class="px-4 py-3">Processed at</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @payroll_runs.each do |payroll_run| %>
          <tr>
            <td class="px-4 py-3 text-gray-900"><%= payroll_run.period_start %> &ndash; <%= payroll_run.period_end %></td>
            <td class="px-4 py-3">
              <span class="text-xs font-medium px-2 py-1 rounded-full <%= payroll_run.completed? ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-600' %>">
                <%= payroll_run.status.titleize %>
              </span>
            </td>
            <td class="px-4 py-3 text-gray-500"><%= payroll_run.processed_at&.to_fs(:long) || "—" %></td>
            <td class="px-4 py-3 text-right">
              <%= link_to "View", payroll_run_path(payroll_run), class: "text-indigo-600 hover:text-indigo-800" %>
            </td>
          </tr>
        <% end %>

        <% if @payroll_runs.none? %>
          <tr><td colspan="4" class="px-4 py-8 text-center text-gray-500">No payroll runs yet.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-4 text-sm text-gray-500">
    <%= raw pagy_nav(@pagy) if @pagy.pages > 1 %>
  </div>
</div>
