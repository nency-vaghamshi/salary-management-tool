<% content_for :title, "New Payroll Run" %>

<div class="w-full max-w-md">
  <h1 class="text-xl font-semibold text-gray-900 mb-1">New Payroll Run</h1>
  <p class="text-sm text-gray-500 mb-6">Calculates final (post-tax) salary for every active employee and saves it as a payroll line item.</p>

  <% if @payroll_run.errors.any? %>
    <div class="rounded-lg bg-red-50 text-red-700 text-sm px-3.5 py-2.5 ring-1 ring-red-100 mb-5">
      <ul class="list-disc list-inside">
        <% @payroll_run.errors.full_messages.each { |message| %><li><%= message %></li><% } %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @payroll_run, url: payroll_runs_path, class: "space-y-5" do |form| %>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= form.label :period_start, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= form.date_field :period_start, value: Date.current.beginning_of_month, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>
      <div>
        <%= form.label :period_end, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= form.date_field :period_end, value: Date.current.end_of_month, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>
    </div>

    <%= form.submit "Run Payroll", class: "inline-flex items-center justify-center bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium rounded-lg px-4 py-2.5 transition-colors cursor-pointer" %>
  <% end %>
</div>
