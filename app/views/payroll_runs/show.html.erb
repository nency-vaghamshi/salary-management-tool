<% content_for :title, "Payroll Run" %>
<% in_progress = @payroll_run.draft? || @payroll_run.processing? %>
<% if in_progress %>
  <% content_for :head do %><meta http-equiv="refresh" content="3"><% end %>
<% end %>

<div class="w-full max-w-3xl">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-xl font-semibold text-gray-900">Payroll Run</h1>
      <p class="text-sm text-gray-500"><%= @payroll_run.period_start %> &ndash; <%= @payroll_run.period_end %></p>
    </div>
    <%= render "status_badge", payroll_run: @payroll_run %>
  </div>

  <% if in_progress %>
    <div class="flex items-center gap-2 rounded-lg bg-blue-50 text-blue-800 text-sm px-4 py-3 ring-1 ring-blue-100 mb-5">
      <svg class="w-4 h-4 animate-spin" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.37 0 0 5.37 0 12h4Z"></path></svg>
      <%= @payroll_run.draft? ? "Waiting for a worker to pick up this run…" : "Calculating payroll for every eligible employee…" %>
    </div>
  <% elsif @payroll_run.failed? %>
    <div class="rounded-lg bg-red-50 text-red-700 text-sm px-4 py-3 ring-1 ring-red-100 mb-5">
      This run failed partway through. Any line items below were saved before the failure; check the job's error in Solid Queue.
    </div>
  <% elsif @payroll_run.completed? %>
    <p class="text-sm text-gray-500 mb-5">
      Processed <%= number_with_delimiter(@payroll_run.payroll_line_items.count) %> employee(s)<%= ", skipped #{number_with_delimiter(@payroll_run.skipped_employees.size)}" if @payroll_run.skipped_employees.any? %>.
    </p>
  <% end %>

  <%= render "shared/employee_search", url: payroll_run_path(@payroll_run),
        departments: @departments, job_titles: @job_titles, countries: @countries %>

  <div class="bg-white rounded-lg ring-1 ring-gray-200 overflow-x-auto">
    <table class="min-w-full text-sm">
      <thead class="bg-gray-50 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">
        <tr>
          <th class="px-4 py-3">Employee</th>
          <th class="px-4 py-3">Salary Record</th>
          <th class="px-4 py-3 text-right">Final Amount</th>
          <th class="px-4 py-3"><span class="sr-only">Payslip</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @line_items.each do |item| %>
          <tr>
            <td class="px-4 py-3"><%= link_to item.employee.full_name, employee_path(item.employee), class: "text-indigo-600 hover:text-indigo-800" %></td>
            <td class="px-4 py-3"><%= link_to item.salary_record.effective_from, salary_record_path(item.salary_record), class: "text-gray-500 hover:text-gray-900" %></td>
            <td class="px-4 py-3 text-right text-gray-900"><%= number_to_currency(item.amount, unit: item.salary_record.currency.symbol) %></td>
            <td class="px-4 py-3 text-right">
              <% if item.payslip %>
                <%= link_to "Payslip", payslip_path(item.payslip), class: "font-medium text-indigo-600 hover:text-indigo-800" %>
              <% else %>
                <span class="text-gray-400" title="Payslips are issued for runs completed after payslips were introduced">&mdash;</span>
              <% end %>
            </td>
          </tr>
        <% end %>

        <% if @line_items.none? %>
          <tr><td colspan="4" class="px-4 py-8 text-center text-gray-500"><%= employee_search_active? ? "No employees in this run match these filters." : "No payroll line items yet." %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="mt-4">
    <%= render "shared/pagination", pagy: @pagy %>
  </div>
</div>
