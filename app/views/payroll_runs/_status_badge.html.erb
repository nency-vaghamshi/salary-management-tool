<% badge_classes = {
     "draft" => "bg-yellow-100 text-yellow-800",
     "processing" => "bg-blue-100 text-blue-800",
     "completed" => "bg-green-100 text-green-700",
     "failed" => "bg-red-100 text-red-700"
   } %>
<span class="text-xs font-medium px-2 py-1 rounded-full <%= badge_classes.fetch(payroll_run.status, "bg-gray-100 text-gray-600") %>">
  <%= payroll_run.draft? ? "Queued" : payroll_run.status.titleize %>
</span>
