<% content_for :title, "Sign in" %>

<div class="min-h-screen grid grid-cols-1 lg:grid-cols-5">
  <div class="hidden lg:flex lg:col-span-2 flex-col justify-between bg-gradient-to-br from-indigo-950 via-indigo-900 to-slate-900 text-white p-12">
    <div class="flex items-center gap-2.5">
      <div class="w-9 h-9 rounded-lg bg-white/10 flex items-center justify-center ring-1 ring-white/20">
        <svg class="w-5 h-5 text-indigo-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-4-8.5c0-1.38 1.79-2.5 4-2.5s4 1.12 4 2.5-1.79 2.5-4 2.5-4 1.12-4 2.5 1.79 2.5 4 2.5 4-1.12 4-2.5" />
        </svg>
      </div>
      <span class="font-semibold tracking-tight">ACME Salary</span>
    </div>

    <div>
      <h1 class="text-3xl font-semibold leading-tight tracking-tight">
        Compensation, managed with confidence.
      </h1>
      <p class="mt-3 text-indigo-200/80 text-sm leading-relaxed max-w-sm">
        One system for salaries, revisions, and audit history across every country your teams work in.
      </p>

      <ul class="mt-10 space-y-5">
        <li class="flex items-start gap-3">
          <span class="mt-0.5 w-6 h-6 shrink-0 rounded-md bg-white/10 flex items-center justify-center ring-1 ring-white/10">
            <svg class="w-3.5 h-3.5 text-indigo-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12a8.25 8.25 0 1 1 16.5 0 8.25 8.25 0 0 1-16.5 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l2.5 2.5" /></svg>
          </span>
          <div>
            <p class="text-sm font-medium">Multi-country payroll</p>
            <p class="text-xs text-indigo-200/70 mt-0.5">Track nationality, residence, and payroll country separately.</p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-0.5 w-6 h-6 shrink-0 rounded-md bg-white/10 flex items-center justify-center ring-1 ring-white/10">
            <svg class="w-3.5 h-3.5 text-indigo-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
          </span>
          <div>
            <p class="text-sm font-medium">Immutable salary history</p>
            <p class="text-xs text-indigo-200/70 mt-0.5">Every revision is effective-dated and fully auditable.</p>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-0.5 w-6 h-6 shrink-0 rounded-md bg-white/10 flex items-center justify-center ring-1 ring-white/10">
            <svg class="w-3.5 h-3.5 text-indigo-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 5.25h16.5M3.75 12h16.5M3.75 18.75h16.5" /></svg>
          </span>
          <div>
            <p class="text-sm font-medium">Built for scale</p>
            <p class="text-xs text-indigo-200/70 mt-0.5">Fast search and reporting across 10,000+ employees.</p>
          </div>
        </li>
      </ul>
    </div>

    <p class="text-xs text-indigo-300/50">&copy; <%= Date.current.year %> ACME Corporation</p>
  </div>

  <div class="col-span-1 lg:col-span-3 flex items-center justify-center p-6 sm:p-12">
    <div class="w-full max-w-sm" data-controller="auth">
      <div class="lg:hidden flex items-center gap-2.5 mb-10">
        <div class="w-9 h-9 rounded-lg bg-indigo-600 flex items-center justify-center">
          <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-4-8.5c0-1.38 1.79-2.5 4-2.5s4 1.12 4 2.5-1.79 2.5-4 2.5-4 1.12-4 2.5 1.79 2.5 4 2.5 4-1.12 4-2.5" />
          </svg>
        </div>
        <span class="font-semibold text-gray-900 tracking-tight">ACME Salary</span>
      </div>

      <h1 class="text-2xl font-semibold text-gray-900">Sign in</h1>
      <p class="text-sm text-gray-500 mt-1 mb-8">HR access only &mdash; enter your credentials to continue.</p>

      <p data-auth-target="error" class="hidden mb-5 flex items-start gap-2 rounded-lg bg-red-50 text-red-700 text-sm px-3.5 py-2.5 ring-1 ring-red-100">
        <svg class="w-4 h-4 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0 3.75h.008v.008H12v-.008ZM21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
        <span>Invalid email or password. Please try again.</span>
      </p>

      <form data-action="submit->auth#submit" novalidate>
        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-1.5" for="email">Email</label>
          <div class="relative">
            <svg class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0-.83.67-1.5 1.5-1.5h16.5c.83 0 1.5.67 1.5 1.5v10.5c0 .83-.67 1.5-1.5 1.5H3.75a1.5 1.5 0 0 1-1.5-1.5V6.75Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="m3 7 9 6 9-6" />
            </svg>
            <input type="email" id="email" name="email" data-auth-target="email" required autofocus
                   autocomplete="email" placeholder="you@company.com"
                   class="w-full rounded-lg border border-gray-300 pl-10 pr-3 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-shadow">
          </div>
        </div>

        <div class="mb-2">
          <label class="block text-sm font-medium text-gray-700 mb-1.5" for="password">Password</label>
          <div class="relative">
            <svg class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 9.75h10.5a1.5 1.5 0 0 0 1.5-1.5v-6.75a1.5 1.5 0 0 0-1.5-1.5H6.75a1.5 1.5 0 0 0-1.5 1.5V18a1.5 1.5 0 0 0 1.5 1.5Z" />
            </svg>
            <input type="password" id="password" name="password" data-auth-target="password" required
                   autocomplete="current-password" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;"
                   class="w-full rounded-lg border border-gray-300 pl-10 pr-3 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-shadow">
          </div>
        </div>

        <button type="submit" data-auth-target="submit"
                class="w-full mt-6 inline-flex items-center justify-center gap-2 bg-indigo-600 hover:bg-indigo-700 disabled:bg-indigo-400 disabled:cursor-not-allowed text-white text-sm font-medium rounded-lg py-2.5 transition-colors">
          <svg data-auth-target="spinner" class="hidden w-4 h-4 animate-spin" viewBox="0 0 24 24" fill="none">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.37 0 0 5.37 0 12h4Z"></path>
          </svg>
          <span data-auth-target="submitLabel">Sign in</span>
        </button>

        <%# <p class="mt-4 text-center"> %>
        <%#   link_to "Forgot password?", new_user_password_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-700" %>
        <%# </p> %>
      </form>

      <p class="mt-6 text-center text-sm text-gray-500">
        Don&rsquo;t have an account?
        <%= link_to "Create one", register_path, class: "font-medium text-indigo-600 hover:text-indigo-700" %>
      </p>
    </div>
  </div>
</div>
